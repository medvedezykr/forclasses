<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mainscreenolor"
    tools:context=".randomset">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/randincbutt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="444dp"
            android:background="@drawable/darkeryellowbutt"
            android:text="@string/countadd" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/randdecbutt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/darkeryellowbutt"
            android:text="@string/countred" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/randgetnum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/darkeryellowbutt"
            android:text="@string/countget" />

    </LinearLayout>

    <TextView
        android:id="@+id/constrview"
        android:layout_width="96dp"
        android:layout_height="144dp"
        android:layout_marginTop="200dp"
        android:gravity="center"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>