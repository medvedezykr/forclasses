<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mainscreenolor"
    tools:context=".MENU">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="175dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/profilebutt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/yellowbutt"
            android:onClick="ToProfile"
            android:text="@string/buttonprofile" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/mediabutt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/yellowbutt"
            android:onClick="ToMedia"
            android:text="@string/mediabutton" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/randnumbutt"
            android:onClick="ToRandom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/yellowbutt"
            android:text="@string/randombutton" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>